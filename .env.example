# Copy this file to .env.local and fill in your own values.
# Never commit .env.local.

# --- PayPal (sandbox) ---------------------------------------------------
# developer.paypal.com -> Apps & Credentials -> Sandbox -> your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" (default) or "mock" to run without PayPal at all (offline demo)
PAYPAL_MODE=sandbox
# Optional: webhook ID from the sandbox app's Webhooks section (enables signature checks)
PAYPAL_WEBHOOK_ID=
# Same value as PAYPAL_CLIENT_ID, exposed to the browser for the PayPal buttons
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- AI (Google Gemini) -------------------------------------------------
# aistudio.google.com -> Get API key. Leave empty to use the built-in mock AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Database -----------------------------------------------------------
# Leave empty to use an embedded local Postgres (PGlite) in ~/.crumb/pglite
# For deployment use a hosted Postgres URL (Supabase / Neon).
DATABASE_URL=

# --- App ----------------------------------------------------------------
# Public base URL, used in links the agent hands back to people
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Shared secret that protects shop-only endpoints in the demo
SHOP_PIN=2468

# Optional: PayPal sandbox *test customer* shown in the in-app tour (sandbox only, never a real account)
NEXT_PUBLIC_DEMO_BUYER_EMAIL=
NEXT_PUBLIC_DEMO_BUYER_PASSWORD=
